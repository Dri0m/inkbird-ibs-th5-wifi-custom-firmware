# Copy to secrets.yaml (gitignored) and fill in. Placeholders only: every
# REPLACE-... value is refused by th5_link's validation (and the API key is not
# valid base64-32), so an unedited copy cannot be compiled.
wifi_ssid: "REPLACE-with-your-ssid"
# Passphrase or the derived 64-hex WPA2 PSK (see the README: use the PSK).
wifi_password: "REPLACE-with-your-wifi-password"
# 32 random bytes, base64: openssl rand -base64 32
api_encryption_key: "REPLACE-with-output-of-openssl-rand-base64-32"
# A long random string: openssl rand -base64 24
ota_password: "REPLACE-with-a-long-random-password"
